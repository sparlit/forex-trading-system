# Forex Trading System - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================
# APP SETTINGS
# ============================================
APP_NAME=forex-trading-system
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# ============================================
# API SETTINGS
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=true
API_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# ============================================
# DATABASE - TIMESCALEDB
# ============================================
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DATABASE=market_data
TIMESCALE_USER=trader
TIMESCALE_PASSWORD=your_password
TIMESCALE_POOL_SIZE=10
TIMESCALE_MAX_OVERFLOW=5
TIMESCALE_SSL_MODE=prefer

# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_MAX_CONNECTIONS=50
REDIS_DECODE_RESPONSES=true

# ============================================
# INFLUXDB
# ============================================
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your_token
INFLUX_ORG=trading
INFLUX_BUCKET=metrics
INFLUX_TIMEOUT=10000

# ============================================
# NATS MESSAGE BUS
# ============================================
NATS_SERVERS=["nats://localhost:4222"]
NATS_NAME=forex-trading-system
NATS_MAX_RECONNECT_ATTEMPTS=-1
NATS_RECONNECT_TIME_WAIT=2

# ============================================
# METATRADER 5
# ============================================
MT5_ENABLED=true
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=YourBroker-Demo
MT5_PATH=
MT5_TIMEOUT=60000
MT5_PORTABLE=false

# ============================================
# CTRADER
# ============================================
CTRADER_ENABLED=false
CTRADER_CLIENT_ID=your_client_id
CTRADER_CLIENT_SECRET=your_client_secret
CTRADER_ACCESS_TOKEN=your_access_token
CTRADER_REFRESH_TOKEN=your_refresh_token
CTRADER_HOST=demo.ctraderapi.com
CTRADER_PORT=443

# ============================================
# CCXT (CRYPTO EXCHANGES)
# ============================================
CCXT_ENABLED=true
CCXT_EXCHANGES=["binance", "bybit", "kraken"]
CCXT_API_KEYS={"binance": {"apiKey": "your_key", "secret": "your_secret"}, "bybit": {"apiKey": "your_key", "secret": "your_secret"}, "kraken": {"apiKey": "your_key", "secret": "your_secret"}}
CCXT_RATE_LIMIT=1200
CCXT_TIMEOUT=30000
CCXT_ENABLE_RATE_LIMIT=true
CCXT_OPTIONS={}

# ============================================
# REST DATA PROVIDERS
# ============================================
TWELVE_DATA_API_KEY=your_key
ALPHA_VANTAGE_API_KEY=your_key
POLYGON_API_KEY=your_key
FINNHUB_API_KEY=your_key

# ============================================
# STRATEGY SETTINGS
# ============================================
STRATEGY_ML_MODELS_PATH=./models
STRATEGY_FEATURE_LOOKBACK=100
STRATEGY_PREDICTION_HORIZON=10
STRATEGY_ENSEMBLE_METHOD=weighted_average
STRATEGY_MIN_CONFIDENCE=0.6
STRATEGY_MAX_CONCURRENT_SIGNALS=10
STRATEGY_SIGNAL_EXPIRY_SECONDS=300

# ============================================
# RISK MANAGEMENT
# ============================================
RISK_MAX_PORTFOLIO_RISK=0.02
RISK_MAX_DRAWDOWN=0.10
RISK_MAX_CORRELATION=0.7
RISK_MAX_LEVERAGE=10.0
RISK_VAR_CONFIDENCE=0.99
RISK_VAR_HORIZON_DAYS=1
RISK_MAX_POSITION_SIZE_PCT=0.10
RISK_MAX_SECTOR_EXPOSURE=0.30
RISK_STOP_OUT_LEVEL=0.50
RISK_MARGIN_CALL_LEVEL=0.80
RISK_DAILY_LOSS_LIMIT=0.05
RISK_WEEKLY_LOSS_LIMIT=0.10
RISK_MONTHLY_LOSS_LIMIT=0.20

# ============================================
# EXECUTION
# ============================================
EXECUTION_DEFAULT_ALGORITHM=adaptive
EXECUTION_MAX_SLIPPAGE_BPS=5
EXECUTION_PARTIAL_FILL_TIMEOUT=30
EXECUTION_MAX_ORDER_AGE_SECONDS=300
EXECUTION_RETRY_ATTEMPTS=3
EXECUTION_RETRY_DELAY_SECONDS=1
EXECUTION_USE_SMART_ROUTING=true
EXECUTION_MIN_ORDER_SIZE=0.01
EXECUTION_MAX_ORDER_SIZE=100.0

# ============================================
# BACKTESTING
# ============================================
BACKTEST_INITIAL_CAPITAL=100000.0
BACKTEST_COMMISSION_PER_LOT=7.0
BACKTEST_SPREAD_BPS=10
BACKTEST_SLIPPAGE_BPS=2
BACKTEST_MAX_POSITIONS=20
BACKTEST_ALLOW_SHORT=true
BACKTEST_MARGIN_REQUIREMENT=0.01

# ============================================
# MONITORING
# ============================================
MONITORING_PROMETHEUS_PORT=9090
MONITORING_GRAFANA_DASHBOARD=forex-trading
MONITORING_ALERT_WEBHOOK_TELEGRAM=
MONITORING_ALERT_WEBHOOK_DISCORD=
MONITORING_ALERT_WEBHOOK_EMAIL=
MONITORING_HEALTH_CHECK_INTERVAL=30

# ============================================
# DASHBOARD
# ============================================
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501
DASHBOARD_THEME=dark
DASHBOARD_AUTO_REFRESH_SECONDS=5

# ============================================
# SECRETS
# ============================================
SECRET_KEY=change-me-in-production-use-secure-random-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
API_KEY_HEADER=X-API-Key