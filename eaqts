#!/usr/bin/env bash
# Cross‑platform launcher for EAQTS on Windows.
# Allows `./eaqts` (or `eaqts` from git‑bash) to run the same
# single‑word command that works in a normal Windows CMD prompt.

# Resolve the directory of this script (the repository root)
# Resolve POSIX path of this script's directory
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Convert to Windows style (e.g., C:\path) for cmd.exe
WIN_DIR=$(cygpath -w "$DIR")

# Invoke the Windows batch wrapper via cmd.exe using the Windows path
cmd.exe /c "\"$WIN_DIR\\eaqts.cmd\" "$@""
